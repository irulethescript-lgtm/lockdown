<div class="contentBlock">
  <div class="blockTitle">Create a Faction</div>
  <div class="blockBody">
    <p style="color:#888; margin-bottom:12px; font-size:11px;">Costs $500 to start a faction. You'll be the leader.</p>
    <div id="gangMsg"></div>
    <div class="form-row"><label>Faction Name (3-24 chars)</label><input type="text" id="gangName" maxlength="24"></div>
    <div class="form-row"><label>Tag (2-4 chars, shown in brackets)</label><input type="text" id="gangTag" maxlength="4"></div>
    <div class="form-row"><label>Description (optional)</label><input type="text" id="gangDesc" maxlength="100"></div>
    <button class="btn" onclick="createGang()">CREATE GANG ($500)</button>
    <a href="/factions" class="btn gray" style="margin-left:8px;">VIEW GANGS</a>
  </div>
</div>
<script>
function createGang() {
  doAction('/gang/create', {
    name: document.getElementById('gangName').value,
    tag: document.getElementById('gangTag').value,
    description: document.getElementById('gangDesc').value,
  }, (d) => {
    document.getElementById('gangMsg').innerHTML = `<div class="success-msg">${esc(d.msg)}</div>`;
    if (d.redirect) setTimeout(() => location.href = d.redirect, 1000);
  });
}
</script>
