<link rel="stylesheet" href="/css/world.css">
<% const phase=travel.phase; const destination=TRAVEL_ROUTES.find(r=>r.id===travel.trip?.destination_id); const moving=['outbound','returning'].includes(phase); const used=travel.cargo.reduce((sum,r)=>sum+r.quantity,0); const arrival=phase==='returning'?travel.trip?.return_arrives_at:travel.trip?.arrives_at; const groups={flowers:'Flowers',plushies:'Plushies',drugs:'Drugs',weapons:'Weapons',boosters:'Boosters',caches:'Caches'}; %>
<div id="travelFeedback" class="game-feedback" role="status" hidden></div>
<div class="world-layout">
  <aside class="world-sidebar"><h2>🌍 Lock down travel</h2><label>Search stock<input id="overseas-search" type="search" placeholder="Search items…"></label><p>Ten countries · one home</p><nav aria-label="Countries"><% TRAVEL_ROUTES.forEach(r=>{ %><% if(phase==='home'){ %><a href="#country-<%= r.id %>"><%= r.flag %> <%= r.name %></a><% }else{ %><span class="<%= destination?.id===r.id?'selected':'' %>" title="Return home to book another destination"><%= r.flag %> <%= r.name %></span><% } %><% }); %></nav><a href="/inventory">My inventory →</a><a href="/market">Home market →</a></aside>
  <section class="world-content">
    <div class="page-heading"><div><div class="eyebrow">INTERNATIONAL EXCHANGE</div><h1><%= destination ? destination.flag+' '+destination.name : 'Choose your next trip' %></h1><p><%= destination?destination.city+' · ':'' %>Capacity: <%= used %> / <%= travel.trip?.capacity || travel.bag.capacity %> · <%= travel.bag.name %></p></div><button class="item-secondary" type="button" onclick="location.reload()">Refresh stock</button></div>
    <% if(moving) { const start=phase==='returning'?travel.trip.return_departed_at:travel.trip.departed_at; %>
    <section class="dashboard-panel"><h2><%= phase==='returning'?'Returning home':'Flying to '+destination.city %></h2><p class="travel-clock" data-arrival="<%= arrival %>">Checking arrival…</p><div class="progress-track"><span id="tripProgress" data-start="<%= start %>"></span></div><p>Your flight continues while you are offline. Your return fare is already paid.</p></section>
    <% } else if(phase==='visiting') { %>
    <div class="world-toolbar"><button class="action-button" data-travel-action="return">Return home</button><span>Hourly restock: <b class="stock-clock" data-restock="<%= travel.offers[0]?.restock_at %>"></b></span></div>
    <p>These 12 items belong to this country's regular catalog. Boosters and caches appear occasionally for the first 20 minutes of an hourly restock. Prices may be higher or lower than at home.</p>
    <% const profitable=travel.offers.filter(i=>i.available&&i.quantity>0).sort((a,b)=>(Math.floor(getItem(b.type,b.key).price*.9)-b.price)-(Math.floor(getItem(a.type,a.key).price*.9)-a.price)).slice(0,3); %>
    <h2 class="world-band">Top 3 in stock · estimated profit</h2>
    <%- include('partials/overseas-table',{offers:profitable,used,travel,destination,groups,getItem,compact:true}) %>
    <div class="world-toolbar"><h2 class="world-band">General store</h2><label>Category <select id="overseas-category"><option value="all">All items</option><% Object.entries(groups).forEach(([key,name])=>{ %><option value="<%= key %>"><%= name %></option><% }); %></select></label></div>
    <%- include('partials/overseas-table',{offers:travel.offers,used,travel,destination,groups,getItem,compact:false}) %>
    <p class="subtle">Estimated profit assumes a player buys at the home reference price, after the 10% listing fee. Sales are not guaranteed; fares and time reduce your return.</p>
    <% } %>
    <% if(phase==='home') { %><section id="destinations" class="destination-grid"><% TRAVEL_ROUTES.forEach(r=>{ %><article id="country-<%= r.id %>" class="dashboard-panel"><h2><%= r.flag %> <%= r.name %></h2><p><%= r.city %> · 12 local items</p><p><%= r.minutes %> minutes each way · $<%= r.fare %> round trip</p><button class="action-button" data-travel-action="depart" data-destination="<%= r.id %>" <%= user.cash<r.fare||user.in_hospital||user.in_jail?'disabled':'' %>>Book flight</button></article><% }); %></section><p>Trips keep your home, job and property. Return home before training, crimes, banking or home trading.</p><% } %>
    <% if(travel.trip) { %><section class="dashboard-panel"><h2>Cargo · <%= used %> / <%= travel.trip.capacity %></h2><% if(!travel.cargo.length) { %><p>Your bag is empty.</p><% } %><% travel.cargo.forEach(c=>{const parts=c.item_key.split(':');const item=parts.length===2?getItem(parts[0],parts[1]):GOODS.find(g=>g.key===c.item_key); %><p><%= item?.name || 'Saved cargo' %> × <%= c.quantity %></p><% }); %></section><% } %>
    <section class="dashboard-panel"><h2>Your luggage</h2><p><%= travel.progress.trips_completed %> completed trips · <%= travel.bag.capacity %> slots</p><% if(travel.nextBag) { %><p><%= travel.nextBag.name %>: <%= travel.nextBag.capacity %> slots · $<%= travel.nextBag.cost.toLocaleString() %> · requires <%= travel.nextBag.trips %> completed trips.</p><button class="action-button" data-travel-action="upgrade" <%= phase!=='home'||travel.progress.trips_completed<travel.nextBag.trips||user.cash<travel.nextBag.cost?'disabled':'' %>>Upgrade bag</button><% } %></section>
    <% const legacy=travel.inventory.filter(i=>GOODS.some(g=>g.key===i.item_key)); if(phase==='home'&&legacy.length) { %><section class="dashboard-panel"><h2>Saved souvenirs</h2><% legacy.forEach(i=>{const g=GOODS.find(g=>g.key===i.item_key); %><p><%= g.name %> × <%= i.quantity %> · collector pays $<%= g.sell %> each</p><input id="sell-<%= g.key %>" type="number" min="1" max="<%= i.quantity %>" value="1"><button data-travel-action="sell" data-item="<%= g.key %>">Sell to collector</button><% }); %></section><% } %>
  </section>
</div>
<script type="application/json" id="travelState"><%- JSON.stringify({phase,now:travel.now,revision:travel.revision}).replace(/</g,'\\u003c') %></script>
<script src="/js/travel.js" defer></script>
