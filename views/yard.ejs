<% const home=TRAVEL_ROUTES.find(r=>r.id===user.prison_id); const destination=TRAVEL_ROUTES.find(r=>r.id===travel.trip?.destination_id); const phase=travel.phase; const used=travel.cargo.reduce((sum,r)=>sum+r.quantity,0); const isHome=phase==='home'; const moving=phase==='outbound'||phase==='returning'; const stockPrison=isHome?user.prison_id:travel.trip?.destination_id; const found=GOODS.filter(g=>travel.discoveries.some(d=>d.item_key===g.key)).length; const arrival=phase==='returning'?travel.trip.return_arrives_at:travel.trip?.arrives_at; %>
<div class="page-heading"><div><div class="eyebrow">AIRPORT / INTERNATIONAL TRADE</div><h1>A bigger world. A better score.</h1><p>Visit another city, find its exclusive goods, and bring your cargo home.</p></div><span class="rank-chip"><%= isHome?'HOME BASE':moving?'IN TRANSIT':'VISITING' %></span></div>
<div id="travelFeedback" class="game-feedback" role="status" aria-live="polite" hidden></div>
<section class="travel-hero">
  <div class="travel-network" aria-hidden="true"><div class="eyebrow">THE EXCHANGE NETWORK</div><svg viewBox="0 0 100 90" focusable="false"><defs><pattern id="travelGrid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M10 0H0V10" fill="none" stroke="#768a97" stroke-opacity=".12" stroke-width=".2"/></pattern></defs><rect width="100" height="90" fill="url(#travelGrid)"/><path d="M8 25L21 16 41 19 53 31 44 44 29 47 18 42ZM50 49L62 48 77 58 81 76 70 84 62 72ZM62 12L87 18 94 36 81 43 73 34 56 29Z" fill="#34434b" fill-opacity=".55"/>
  <% TRAVEL_ROUTES.filter(r=>r.id!==home.id).forEach(r=>{ %><line x1="<%= home.x %>" y1="<%= home.y %>" x2="<%= r.x %>" y2="<%= r.y %>" stroke="<%= destination?.id===r.id?'#dfb373':'#687985' %>" stroke-width="<%= destination?.id===r.id?'.65':'.25' %>" stroke-dasharray="1.5 1.5"/><% }); %>
  <% TRAVEL_ROUTES.forEach(r=>{ %><circle cx="<%= r.x %>" cy="<%= r.y %>" r="<%= r.id===home.id?'2':'1.5' %>" fill="<%= r.id===home.id?'#dfb373':r.color %>"/><text x="<%= r.x+3 %>" y="<%= r.y+1 %>" fill="#d9e1e5" font-size="2.6"><%= r.name %></text><% }); %></svg><span class="network-caption">PLAN · TRAVEL · COLLECT · RETURN</span></div>
  <div class="travel-status"><span class="eyebrow"><%= isHome?'YOUR NEXT RUN STARTS HERE':phase==='visiting'?'YOU HAVE ARRIVED':phase==='returning'?'BRINGING IT HOME':'ON THE MOVE' %></span><h2><%= isHome?home.name:phase==='returning'?home.name:destination.name %></h2><p><%= isHome?'Pick a destination below. Your round-trip fare is paid before departure.':phase==='visiting'?'Browse the local exchange, fill your bag, then head home.':phase==='returning'?'Your cargo is secure. It will enter your inventory automatically when you arrive.':'The clock keeps running offline. The local exchange opens when you arrive.' %></p>
  <% if(moving) { const start=phase==='returning'?travel.trip.return_departed_at:travel.trip.departed_at; %><div class="travel-clock" data-arrival="<%= arrival %>">Calculating arrival…</div><div class="progress-track large"><span id="tripProgress" data-start="<%= start %>" style="width:<%= Math.min(100,Math.max(0,(travel.now-start)/(arrival-start)*100)) %>%"></span></div><small class="subtle"><%= phase==='returning'?destination.name+' → '+home.name:home.name+' → '+destination.name %></small>
  <% } else if(phase==='visiting') { %><button class="action-button" data-travel-action="return">Return to <%= home.name %> →</button><small class="subtle">Return fare already paid. You can leave with an empty bag.</small>
  <% } else { %><a class="action-button" href="#destinations">Choose your destination ↘</a><small class="subtle">Every destination is available from level 1.</small><% } %>
  </div>
</section>
<div class="travel-stats"><div><span>CARGO BAG</span><strong><%= travel.bag.name %></strong><small><%= travel.trip?used:0 %> / <%= travel.trip?.capacity || travel.bag.capacity %> slots used</small></div><div><span>ROUND TRIPS</span><strong><%= travel.progress.trips_completed %></strong><small>Completed visits</small></div><div><span>COLLECTION</span><strong><%= found %> / <%= GOODS.length %></strong><small>Unique items discovered</small></div><div><span>COLLECTOR SALES</span><strong>$<%= travel.progress.sales_cash.toLocaleString() %></strong><small>Lifetime sales before costs</small></div></div>
<% if(user.in_jail || user.in_hospital) { %><div class="status-warning">Recover from <%= user.in_jail?'jail':'the hospital' %> before departing.</div><% } %>
<% if(isHome) { %>
<section id="destinations" class="dashboard-panel"><div class="panel-heading"><h2>Choose a destination</h2><span class="subtle">Fare covers both legs · each item uses one slot</span></div><div class="destination-grid">
<% TRAVEL_ROUTES.filter(r=>r.id!==home.id).forEach(route=>{ const goods=GOODS.filter(g=>g.prison===route.id); %><article class="destination-card" style="--route-color:<%= route.color %>"><div class="destination-top"><span class="route-mark">0<%= route.id %> /</span><span class="small-badge"><%= route.minutes %> MIN EACH WAY</span></div><h3><%= route.name %></h3><p><%= route.subtitle %></p><ul><% goods.forEach(g=>{ %><li><span class="good-symbol"><%= g.symbol %></span><span><%= g.name %><small>Buy $<%= g.buy %> · collector pays $<%= g.sell %></small></span></li><% }); %></ul><div class="destination-fare"><strong>$<%= route.fare %></strong><small>round-trip fare</small></div><button class="action-button" data-travel-action="depart" data-destination="<%= route.id %>" <%= user.in_jail||user.in_hospital||user.cash<route.fare?'disabled':'' %>><%= user.cash<route.fare?'Need more cash':'Book flight ↗' %></button></article><% }); %>
</div><p class="panel-intro travel-note">Visits keep your home city, job, bank and property. Training, crimes, banking and home trading are unavailable while away. Energy and nerve still recover, and courses keep running. A permanent move is available at <a href="/relocate">City Relocation</a>.</p></section>
<% } %>
<% if(!moving) { %>
<section class="dashboard-panel"><div class="panel-heading"><h2><%= isHome?'Home souvenir exchange':destination.name+' · local exchange' %></h2><span class="subtle">Shared stock · restocks in <b class="stock-clock" data-restock="<%= travel.stock[0]?.restock_at %>">…</b></span></div><p class="panel-intro"><%= isHome?'Finish your collection with home souvenirs at collector prices. Travel to buy other cities’ goods at lower local prices.':'Pack goods at local prices. Collector values are guaranteed back home; compare the margin against your fare. Cargo space and stock are limited.' %></p><div class="exchange-grid">
<% GOODS.filter(g=>g.prison===stockPrison).forEach(g=>{ const stock=travel.stock.find(s=>s.item_key===g.key); const price=isHome?g.sell:g.buy; const max=Math.max(0,Math.min(stock.quantity,Math.floor(user.cash/price),isHome?50:travel.trip.capacity-used)); %>
<article class="exchange-card"><span class="collectible-art" aria-hidden="true"><%= g.symbol %></span><div><span class="eyebrow"><%= isHome?'HOME SOUVENIR':'EXCLUSIVE IMPORT' %></span><h3><%= g.name %></h3><p><%= g.desc %></p><div class="exchange-prices"><strong>$<%= price %><small> local price</small></strong><span>Home collector: $<%= g.sell %></span><span><b data-stock="<%= g.key %>"><%= stock.quantity %></b> in stock</span></div><div class="cargo-buy"><label for="buy-<%= g.key %>">Quantity</label><input id="buy-<%= g.key %>" data-price="<%= price %>" type="number" min="1" step="1" max="<%= max %>" value="1"><button class="action-button" data-travel-action="buy" data-item="<%= g.key %>" <%= max<1?'disabled':'' %>><%= isHome?'Collect':'Pack cargo' %></button></div></div></article><% }); %>
</div></section><% } %>
<% if(!isHome) { %><section class="dashboard-panel"><div class="panel-heading"><h2>Your cargo manifest</h2><span class="small-badge"><%= used %> / <%= travel.trip.capacity %> SLOTS</span></div><% if(!travel.cargo.length) { %><p class="panel-intro">Your bag is empty. Buy goods after arrival, or return home at no extra cost.</p><% } %><% travel.cargo.forEach(row=>{const g=GOODS.find(g=>g.key===row.item_key); %><div class="specialty-row"><div><strong><%= g.name %> × <%= row.quantity %></strong><small>Home collector value: $<%= (g.sell*row.quantity).toLocaleString() %></small></div><span class="good-symbol"><%= g.symbol %></span></div><% }); %></section><% } %>
<section class="dashboard-panel" id="collection"><div class="panel-heading"><h2>Your collection book</h2><span class="small-badge"><%= found %> / 10 DISCOVERED</span></div><p class="panel-intro">Discover all ten goods through visits, home souvenirs, or player trades. Discoveries stay recorded after selling. Imported goods arrive in your inventory when you return home.</p><div class="collection-grid"><% GOODS.forEach(g=>{ const seen=travel.discoveries.some(d=>d.item_key===g.key); const qty=travel.inventory.find(i=>i.item_key===g.key)?.quantity||0; const route=TRAVEL_ROUTES.find(r=>r.id===g.prison); %><article class="collection-card <%= seen?'discovered':'' %>"><span class="good-symbol"><%= seen?g.symbol:'?' %></span><div><h3><%= g.name %></h3><small><%= route.name %> · <%= seen?'Discovered ✓':'Undiscovered' %></small><strong><%= qty %> owned · sell $<%= g.sell %> each</strong><% if(qty>0 && isHome) { %><div class="cargo-buy"><label class="sr-only" for="sell-<%= g.key %>">Sell quantity for <%= g.name %></label><input id="sell-<%= g.key %>" type="number" min="1" step="1" max="<%= qty %>" value="1"><button class="action-button" data-travel-action="sell" data-item="<%= g.key %>">Sell to collector</button></div><% } %></div></article><% }); %></div><div class="daily-reward"><div><span class="eyebrow">ALL TEN DISCOVERED</span><strong>$1,500 <span>+ 5 reputation · once per account</span></strong></div><button class="action-button" data-travel-action="collection" <%= !isHome||found<10||travel.progress.collection_claimed?'disabled':'' %>><%= travel.progress.collection_claimed?'Reward collected ✓':'Claim collection reward' %></button></div><a class="text-link" href="/openmarket?cat=collectible">Trade collectibles with other players →</a></section>
<div class="dashboard-grid"><section class="dashboard-panel"><div class="panel-heading"><h2>Build your carrying power</h2></div><p class="panel-intro"><%= travel.bag.name %> · <%= travel.bag.capacity %> cargo slots.</p><% if(travel.nextBag) { %><h3><%= travel.nextBag.name %> · <%= travel.nextBag.capacity %> slots</h3><p class="panel-intro">Requires <%= travel.nextBag.trips %> completed trips and $<%= travel.nextBag.cost.toLocaleString() %>. Applies to your next departure.</p><button class="action-button" data-travel-action="upgrade" <%= !isHome||travel.progress.trips_completed<travel.nextBag.trips||user.cash<travel.nextBag.cost?'disabled':'' %>>Upgrade cargo bag</button><% } else { %><p class="panel-intro">Largest bag unlocked. Every trip can bring home 16 goods.</p><% } %></section><section class="dashboard-panel"><div class="panel-heading"><h2>Recent runs</h2></div><% if(!travel.history.length){ %><p class="panel-intro">Your first completed round trip will appear here.</p><% } %><% travel.history.forEach(t=>{const r=TRAVEL_ROUTES.find(r=>r.id===t.destination_id); %><div class="specialty-row"><strong><%= r.name %></strong><small><%= timeAgo(t.completed_at) %></small></div><% }); %></section></div>
<script type="application/json" id="travelState"><%- JSON.stringify({phase,now:travel.now,revision:travel.revision}).replace(/</g,'\\u003c') %></script>
<script src="/js/travel.js" defer></script>
