<div class="command-center">
  <div class="page-heading"><div><div class="eyebrow">CITIZEN OVERVIEW / <%= prison.short %></div><h1>Build your empire.</h1><p>Every empire starts with a first move, <%= user.username %>.</p></div><span class="rank-chip">LEVEL <%= user.level %> · <%= title %></span></div>
  <% if (user.in_hospital || user.in_jail) { %>
  <div class="status-warning">You are in <%= user.in_jail ? 'jail' : 'the hospital' %>. <a href="<%= user.in_jail ? '/jail' : '/hospital' %>">View your recovery →</a></div>
  <% } %>
  <section class="empire-hero">
    <div class="hero-copy"><div class="eyebrow">THE LONG GAME</div><h2>Respect is earned.<br>Power is built.</h2><p>Train your stats. Master your hustle.<br>Find your crew and rise through the ranks.</p><a class="action-button" href="/crimes">Find your next score <span>↗</span></a></div>
    <img src="/PRISONHALL1.png" alt="Original LOCKDOWN hall artwork">
    <div class="hero-location"><span class="live-dot"></span><%= prison.name %></div>
  </section>
  <div class="overview-stats">
    <a href="/bank"><span>NET WORTH</span><strong>$<%= formatCash(user.cash + (user.bank || 0)) %></strong><small>$<%= formatCash(user.bank || 0) %> secured in the bank</small></a>
    <a href="/most-wanted"><span>REPUTATION</span><strong><%= user.rep.toLocaleString() %></strong><small><%= title %></small></a>
    <a href="/gym"><span>COMBAT STATS</span><strong><%= (user.strength + user.defense + user.speed + user.dexterity).toLocaleString() %></strong><small>STR <%= user.strength %> · DEF <%= user.defense %> · SPD <%= user.speed %> · DEX <%= user.dexterity %></small></a>
    <a href="/battles"><span>FIGHT RECORD</span><strong><%= user.wins %><em> / <%= user.losses %></em></strong><small>Wins / losses</small></a>
  </div>
  <div class="dashboard-grid">
    <section class="dashboard-panel" id="daily">
      <div class="panel-heading"><h2>Daily objectives</h2><span class="subtle" id="dailyReset" data-reset="<%= daily.resetAt %>">Resets at 00:00 UTC</span></div>
      <p class="panel-intro">Small moves. Steady progress. Complete both to collect your reward.</p>
      <% [{name:'Make your moves', desc:'Attempt 3 crimes', href:'/crimes', value:daily.crimes, target:3}, {name:'Put in the work', desc:'Complete 2 gym sessions', href:'/gym', value:daily.training, target:2}].forEach(goal => { %>
      <a class="objective-row" href="<%= goal.href %>"><span class="objective-check <%= goal.value >= goal.target ? 'complete' : '' %>"><%= goal.value >= goal.target ? '✓' : '↗' %></span><div><strong><%= goal.name %></strong><small><%= goal.desc %></small><div class="progress-track"><span style="width:<%= Math.min(100, goal.value / goal.target * 100) %>%"></span></div></div><b><%= Math.min(goal.value, goal.target) %>/<%= goal.target %></b></a>
      <% }); %>
      <div class="daily-reward"><div><span class="eyebrow">COMPLETION REWARD</span><strong>$500 <span>+ 3 reputation</span></strong></div><button id="claimDaily" class="action-button" <%= !daily.complete || daily.claimed ? 'disabled' : '' %>><%= daily.claimed ? 'Collected ✓' : 'Claim reward' %></button></div>
      <p id="dailyFeedback" class="subtle" role="status"></p>
    </section>
    <section class="dashboard-panel"><div class="panel-heading"><h2>The next chapter</h2><span class="small-badge">PROGRESSION</span></div><div class="level-summary"><strong><%= user.level %></strong><div><b>Level <%= user.level %></b><small><%= user.xp %> / <%= user.xp_needed %> XP toward level <%= user.level + 1 %></small></div></div><div class="progress-track large"><span style="width:<%= xpPct %>%"></span></div>
      <% if (nextPrison) { %><div class="next-unlock"><span class="eyebrow">NEXT CITY UNLOCK</span><h3><%= nextPrison.name %></h3><p>Reach level <%= nextPrison.level_req %> to unlock a new city, better jobs, and bigger scores.</p><a class="text-link" href="/relocate">View city transfers →</a></div><% } else { %><div class="next-unlock"><h3>The top is yours to defend.</h3><p>You have unlocked every city. Keep building your reputation.</p><a class="text-link" href="/most-wanted">View the rankings →</a></div><% } %>
    </section>
  </div>
  <section class="dashboard-panel"><div class="panel-heading"><h2>Your long game</h2><a class="text-link" href="/education">Education →</a></div><div class="perk-grid"><span>Police heat <b><%= user.heat %> / 100</b></span><span>Gym gains <b>+<%= user.perks.training %>% from study</b></span><span>Current course <b><%= activeCourse ? COURSES.find(c=>c.key===activeCourse.course_key)?.name || 'Studying' : 'Choose your first course' %></b></span></div><p class="panel-intro"><%= activeCourse ? (activeCourse.finishes_at <= Math.floor(Date.now()/1000) ? 'Your course is ready. Collect your permanent perk.' : 'Study continues offline. Train, earn and trade while you wait.') : 'Invest crime earnings into permanent skills. Six courses improve crime, training, and combat.' %></p></section>
  <section class="dashboard-panel"><div class="panel-heading"><h2>Make your next move</h2><span class="subtle">Your time. Your strategy.</span></div><div class="activity-grid">
    <% [{n:'01',name:'Criminal enterprise',desc:'Practice crimes. Build mastery. Lower your risk.',url:'/crimes',label:'Commit crimes'}, {n:'02',name:'Get stronger',desc:'Turn energy into stats and experience.',url:'/gym',label:'Hit the gym'}, {n:'03',name:gang ? gang.name : 'Find your people',desc:gang ? 'Build your faction’s influence together.' : 'Join a faction and grow your influence.',url:gang ? '/my-faction' : '/factions',label:gang ? 'Your faction' : 'Explore factions'}, {n:'04',name:'Go further',desc:'Visit other cities. Bring home exclusive goods.',url:'/airport',label:'Plan a trip'}].forEach(a => { %>
    <a class="activity-card" href="<%= a.url %>"><span class="activity-number"><%= a.n %> /</span><h3><%= a.name %></h3><p><%= a.desc %></p><span class="text-link"><%= a.label %> ↗</span></a><% }); %>
  </div></section>
  <div class="dashboard-grid bottom-grid">
    <section class="dashboard-panel"><div class="panel-heading"><h2>Your specialties</h2><a class="text-link" href="/crimes">All crimes ↗</a></div>
      <% if (!specialties.length) { %><div class="empty-state"><span>↗</span><h3>A reputation starts with practice.</h3><p>Attempt your first crime to start tracking mastery. Every 10 successes improves the payout and lowers your risk.</p><a class="text-link" href="/crimes">Start your first hustle →</a></div><% } %>
      <% specialties.forEach(skill => { %><div class="specialty-row"><div><strong><%= skill.name %></strong><small><%= skill.successes %> successes · +<%= skill.rewardBonus %>% cash</small></div><span class="rank-chip">LVL <%= skill.level %></span></div><% }); %>
    </section>
    <section class="dashboard-panel"><div class="panel-heading"><h2>Recent activity</h2><a class="text-link" href="/events">View all ↗</a></div><% if (!recentEvents.length) { %><div class="empty-state"><h3>Your story starts here.</h3><p>Crimes, rewards, and other events will appear here as you play.</p></div><% } %><% recentEvents.forEach(event => { %><div class="activity-event"><span class="event-dot"></span><div><p><%= event.message %></p><small><%= timeAgo(event.created_at) %></small></div></div><% }); %></section>
  </div>
</div>
<script src="/js/dashboard.js" defer></script>
