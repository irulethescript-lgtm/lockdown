<style>
#yardWrap { position:relative; width:100%; display:block; }
#yardImg  { width:100%; display:block; border:2px solid #555; border-top:3px solid #888; }
#yardTooltip {
  display:none; position:absolute;
  background:rgba(0,0,0,0.92); border:1px solid #cc4400;
  color:#fff; font-family:'Oswald',Arial,sans-serif;
  font-size:13px; padding:6px 16px; pointer-events:none;
  white-space:nowrap; letter-spacing:1px; z-index:999;
}
.yspot {
  position:absolute; cursor:pointer;
  border:2px solid transparent; border-radius:2px;
  transition: background 0.1s, border-color 0.1s, box-shadow 0.1s;
}
</style>

<div id="yardWrap">
  <img id="yardImg" src="/img/yard.png" alt="City Airport" draggable="false">

  <!-- Prison block (left building) -->
  <div class="yspot" style="left:0%;top:0%;width:33%;height:57%;"
    data-url="/hospital" data-label="City Block — Hospital"
    onmouseover="hs(this,'220,60,60')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Warehouse / garage (centre back) -->
  <div class="yspot" style="left:33%;top:5%;width:30%;height:40%;"
    data-url="/market" data-label="Warehouse — Black Market"
    onmouseover="hs(this,'200,0,220')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Transport van / guard tower (top right) -->
  <div class="yspot" style="left:75%;top:0%;width:25%;height:32%;"
    data-url="/airport" data-label="Airport — Travel abroad"
    onmouseover="hs(this,'80,160,255')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Picnic / canteen area (right) -->
  <div class="yspot" style="left:71%;top:24%;width:29%;height:30%;"
    data-url="/yard?zone=tables" data-label="Picnic Area — Hang Out"
    onmouseover="hs(this,'0,210,90')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Open centre yard / enter dungeon -->
  <div class="yspot" style="left:28%;top:35%;width:28%;height:25%;"
    data-url="/yard" data-label="Open Airport — Enter &amp; Explore"
    onmouseover="hs(this,'255,220,0')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Basketball court (centre right) -->
  <div class="yspot" style="left:43%;top:42%;width:35%;height:42%;"
    data-url="/yard?zone=basketball" data-label="Basketball Court"
    onmouseover="hs(this,'0,160,255')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Weight / gym area (bottom left — punch bag, dumbbells, bench) -->
  <div class="yspot" style="left:0%;top:55%;width:30%;height:45%;"
    data-url="/gym" data-label="Weight Area — The Gym"
    onmouseover="hs(this,'255,130,0')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Picnic table centre (lone bench mid-yard) -->
  <div class="yspot" style="left:28%;top:56%;width:18%;height:16%;"
    data-url="/yard?zone=tables" data-label="Picnic Bench"
    onmouseover="hs(this,'0,210,90')" onmouseout="hu(this)" onclick="gt(this)"></div>

  <!-- Title -->
  <div style="position:absolute;top:0;left:0;background:rgba(0,0,0,0.62);padding:5px 16px;pointer-events:none;">
    <span style="font-family:'Oswald',sans-serif;font-size:16px;color:#fff;letter-spacing:2px;text-shadow:0 1px 4px #000;">City Airport</span>
  </div>

  <div id="yardTooltip"></div>
</div>

<div style="background:#0d0a06;border:1px solid #333;border-top:2px solid #555;
     padding:6px 14px;font-size:11px;color:#888;font-style:italic;
     display:flex;justify-content:space-between;align-items:center;">
  <span>Sun, concrete, and danger. Click an area to interact.</span>
  <span style="color:#555;font-size:10px;">Hover to reveal zones</span>
</div>

<script>
function hs(el, rgb) {
  el.style.background   = 'rgba('+rgb+',0.20)';
  el.style.borderColor  = 'rgba('+rgb+',0.95)';
  el.style.boxShadow    = '0 0 14px rgba('+rgb+',0.45), inset 0 0 6px rgba('+rgb+',0.15)';
  const tt = document.getElementById('yardTooltip');
  tt.textContent = '▶  ' + el.getAttribute('data-label');
  tt.style.display = 'block';
  el.onmousemove = function(e) {
    const r = document.getElementById('yardWrap').getBoundingClientRect();
    tt.style.left = (e.clientX - r.left + 16) + 'px';
    tt.style.top  = (e.clientY - r.top  - 40) + 'px';
  };
}
function hu(el) {
  el.style.background  = 'transparent';
  el.style.borderColor = 'transparent';
  el.style.boxShadow   = 'none';
  document.getElementById('yardTooltip').style.display = 'none';
}
function gt(el) { window.location.href = el.getAttribute('data-url'); }
</script>
