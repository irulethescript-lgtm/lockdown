<h1>City Marketplace</h1>
<p style="font-size:11px;color:#888;">Buy weapons, armor, gear and items. Only Tier 1–<%= maxTier %> items available in <strong style="color:#fff;"><%= prison.name %></strong>. Higher security cities stock better gear. <a href="/market" style="color:#cc4400;">&larr; Back to Market</a></p>

<div id="mktMsg" style="display:none;margin-bottom:8px;" class="result-box show"></div>

<div class="cellToggleBar" style="margin-bottom:8px;">
  <span id="tab_weapon"  class="active" onclick="showTab('weapon')">⚔️ Weapons</span>
  <span id="tab_armor"             onclick="showTab('armor')">🛡️ Armor</span>
  <span id="tab_gear"              onclick="showTab('gear')">🧤 Gear</span>
  <span id="tab_item"              onclick="showTab('item')">💊 Items</span>
  <span id="tab_drug"              onclick="showTab('drug')">🌿 Drugs</span>
</div>

<% [
  { id:'weapon', label:'Weapons',  items: weaponItems },
  { id:'armor',  label:'Armor',    items: armorItems  },
  { id:'gear',   label:'Gear',     items: gearItems   },
  { id:'item',   label:'Items',    items: basicItems  },
  { id:'drug',   label:'Drugs',    items: drugItems   },
].forEach(section => { %>
<div id="section_<%= section.id %>" class="shopSection" style="<%= section.id !== 'weapon' ? 'display:none;' : '' %>">
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;">
    <% section.items.forEach(([key, item]) => { %>
    <div class="shopCard">
      <div style="text-align:center;margin-bottom:3px;"><img src="<%= item.img || '/amenities/default.png' %>" style="width:48px;height:58px;object-fit:contain;" onerror="this.src='/amenities/default.png'"></div>
      <div style="font-family:'Oswald',sans-serif;font-size:11px;color:#fff;text-align:center;"><%= item.name %></div>
      <div style="font-size:9px;color:#00aa00;text-align:center;margin:2px 0;"><%= item.desc %></div>
      <div style="font-size:12px;color:#ccaa00;text-align:center;font-weight:bold;margin-bottom:5px;">$<%= item.price.toLocaleString() %></div>
      <% if (item.tier) { %>
        <div style="text-align:center;margin-bottom:4px;">
          <% for(let t=1;t<=5;t++) { %><span style="font-size:8px;color:<%= t<=item.tier?'#ccaa00':'#333' %>;">★</span><% } %>
        </div>
      <% } %>
      <button class="widebutton" style="width:100%;" onclick="buyItem('<%= key %>','<%= section.id %>',this)">Buy</button>
    </div>
    <% }); %>
  </div>
</div>
<% }); %>

<style>
.cellToggleBar { display:flex; flex-wrap:wrap; }
.cellToggleBar span {
  padding:5px 12px; background:#1a1a18; border:1px solid #555553;
  color:#aaa; font-size:11px; cursor:pointer;
}
.cellToggleBar span.active { background:#cc0000; color:#fff; border-color:#cc0000; }
.shopCard {
  background:rgba(0,0,0,0.4); border:1px solid #333;
  border-top:2px solid #555; padding:10px; transition:border-color 0.15s;
}
.shopCard:hover { border-color:#cc0000; }
</style>

<script>
function showTab(tab) {
  document.querySelectorAll('.shopSection').forEach(s=>s.style.display='none');
  document.querySelectorAll('.cellToggleBar span').forEach(s=>s.classList.remove('active'));
  document.getElementById('section_'+tab).style.display='';
  document.getElementById('tab_'+tab).classList.add('active');
}
// Auto-open tab from URL
const _startTab = '<%= activeTab %>';
const _tabMap = { weapons:'weapon', armor:'armor', gear:'gear', items:'item', drugs:'drug' };
document.addEventListener('DOMContentLoaded', () => showTab(_tabMap[_startTab] || 'weapon'));
function buyItem(key, type, btn) {
  btn.disabled=true;
  fetch('/marketplace/buy', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({ item_key:key, item_type:type })
  }).then(r=>r.json()).then(d=>{
    const el=document.getElementById('mktMsg');
    el.style.display='block';
    if (d.error) {
      el.style.color='#ff6666'; el.style.borderColor='#cc0000'; el.textContent=d.error;
    } else {
      el.style.color='#00cc00'; el.style.borderColor='#00cc00'; el.textContent=d.msg;
      if(d.user) updateStats(d.user);
    }
    btn.disabled=false;
  });
}
</script>
