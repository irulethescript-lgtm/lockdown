    <!-- Hover tooltip -->
    <div id="marketHint" style="display:none;position:absolute;background:rgba(0,0,0,0.88);border:1px solid #cc4400;color:#fff;font-family:'Oswald',Arial;font-size:13px;padding:6px 14px;border-radius:2px;pointer-events:none;white-space:nowrap;letter-spacing:0.5px;"></div>
