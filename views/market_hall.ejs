<style>
.hotspot:hover { cursor: pointer; }
</style>

<script>
const hlMap = {
  '/shop?tab=weapons': { id:'hl_weapons', color:'255,80,0' },
  '/shop?tab=armor':   { id:'hl_armor',   color:'0,200,0' },
  '/shop?tab=items':   { id:'hl_items',   color:'0,120,255' },
  '/shop?tab=drugs':   { id:'hl_drugs',   color:'180,0,180' },
  '/shop?tab=gear':    { id:'hl_gear',    color:'220,160,0' },
  '/openmarket':                     { id:'hl_open',    color:'255,200,0' },
};

function showHint(el) {
  const hint = document.getElementById('marketHint');
  const label = el.getAttribute('data-label');
  const url = el.getAttribute('data-url');
  hint.textContent = '▶ ' + label;
  hint.style.display = 'block';
  // Highlight
  const h = hlMap[url];
  if (h) {
    const hl = document.getElementById(h.id);
    hl.setAttribute('fill', 'rgba('+h.color+',0.12)');
    hl.setAttribute('stroke', 'rgba('+h.color+',0.7)');
  }
  el.addEventListener('mousemove', moveHint);
}

function moveHint(e) {
  const hint = document.getElementById('marketHint');
  const rect = hint.parentElement.getBoundingClientRect();
  hint.style.left = (e.clientX - rect.left + 10) + 'px';
  hint.style.top  = (e.clientY - rect.top  - 30) + 'px';
}

function hideHint() {
  document.getElementById('marketHint').style.display = 'none';
  Object.values(hlMap).forEach(h => {
    const hl = document.getElementById(h.id);
    if (hl) { hl.setAttribute('fill','rgba('+h.color+',0)'); hl.setAttribute('stroke','rgba('+h.color+',0)'); }
  });
}

function goTo(el) {
  window.location.href = el.getAttribute('data-url');
}
</script>
