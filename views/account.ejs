<div class="page-heading"><div><div class="eyebrow">YOUR ACCOUNT</div><h1><%= user.username %></h1><p>Level <%= user.level %> · <%= title %> · Citizen #<%= user.id %></p></div><a class="action-button" href="/profile/<%= user.username %>">View public profile ↗</a></div>
<div class="overview-stats"><a href="/bank"><span>CASH</span><strong>$<%= formatCash(user.cash) %></strong><small>$<%= formatCash(user.bank || 0) %> in the bank</small></a><a href="/gym"><span>COMBAT STATS</span><strong><%= user.strength + user.defense + user.speed + user.dexterity %></strong><small>Strength + defense + speed + dexterity</small></a><a href="/most-wanted"><span>REPUTATION</span><strong><%= user.rep %></strong><small><%= title %></small></a><a href="/battles"><span>RECORD</span><strong><%= user.wins %> / <%= user.losses %></strong><small>Wins / losses</small></a></div>
<section class="dashboard-panel"><div class="panel-heading"><h2>Make it your own</h2><a class="text-link" href="/surgeon">Customize your avatar →</a></div><p class="panel-intro">Your profile shows your identity, reputation, and battle record. Build your stats at the gym and choose your equipment for your next fight.</p><a class="text-link" href="/equipment">Manage equipment →</a></section>
<section class="dashboard-panel"><div class="panel-heading"><h2>Recent fights</h2><a class="text-link" href="/battles">Enter the arena →</a></div><% if (!recentAttacks.length) { %><div class="empty-state"><p>No fights yet. Train your stats before challenging another citizen.</p></div><% } %><% recentAttacks.forEach(attack => { const won=attack.attacker_id===user.id ? attack.attacker_won : !attack.attacker_won; %><div class="specialty-row"><div><strong><%= attack.attacker_name %> vs <%= attack.defender_name %></strong><small><%= timeAgo(attack.created_at) %></small></div><span class="rank-chip"><%= attack.result==='draw' ? 'Draw' : won ? 'Victory' : 'Defeat' %></span></div><% }); %></section>
