<link rel="stylesheet" href="/css/property.css">
<main class="property-page">
<div class="page-heading"><div><div class="eyebrow">YOUR ADDRESS / LOCK DOWN</div><h1>My Property</h1><p>Buy a home, move in and furnish it your way.</p></div><a class="text-link" href="#property-store">Browse properties →</a></div>
<p id="property-feedback" class="game-feedback" role="status" hidden></p>
<section class="home-hero"><div class="home-symbol" aria-hidden="true"><%= active.icon %></div><div><span class="eyebrow">YOU LIVE HERE</span><h2><%= active.name %></h2><p><%= active.description %></p><p><strong><%= furnishings.filter(f=>f.placed_tile!==null).length %> / <%= active.capacity %></strong> furnishings · Happiness <strong><%= user.happiness %> / <%= user.max_happiness %></strong></p><a class="action-button" href="#furnishing-store">Buy furnishings</a></div></section>
<section id="property-store"><h2>Find your next home</h2><div class="home-cards"><% HOMES.forEach(h=>{const mine=owned.some(o=>o.home_key===h.key); %><article class="dashboard-panel"><span class="home-icon" aria-hidden="true"><%= h.icon %></span><h3><%= h.name %></h3><p><%= h.description %></p><p><%= h.capacity %> furnishing spaces</p><strong><%= h.price?'$'+h.price.toLocaleString():'Included' %></strong><% if(active.key===h.key) { %><p class="home-active">Current home</p><% }else { %><button class="action-button" data-property-action="<%= mine?'move-in':'buy-home' %>" data-home="<%= h.key %>" <%= !mine&&user.cash<h.price?'disabled':'' %>><%= mine?'Move in':'Buy property' %></button><% } %></article><% }); %></div></section>
<% for(const placed of [true,false]) {const rows=furnishings.filter(f=>(f.placed_tile!==null)===placed); %>
<section class="dashboard-panel"><h2><%= placed?'In your home':'In storage' %></h2><p><%= placed?'These furnishings provide their listed bonuses.':'Add furnishings to your home to activate their benefits.' %></p><div class="furnishing-list"><% rows.forEach(f=>{const item=CELL_AMENITIES[f.item_key]; %><article><img src="<%= item?.img||'/amenities/default.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/amenities/default.png'"><div><h3><%= item?.name||'Saved furnishing' %></h3><p><%= item?.desc||'' %></p><small><%= f.protected?'Protected furnishing':'' %></small></div><button class="action-button" data-property-action="<%= placed?'remove':'place' %>" data-id="<%= f.id %>" <%= !item?'disabled':'' %>><%= placed?'Store':'Add to home' %></button></article><% }); %></div><% if(!rows.length) { %><p>No furnishings here yet.</p><% } %></section><% } %>
<section class="dashboard-panel" id="furnishing-store"><h2>Furnishing store</h2><label>Find something for your home <input type="search" id="furnishing-search" placeholder="Search furnishings…"></label><div class="home-cards"><% Object.entries(CELL_AMENITIES).filter(([,i])=>Number.isSafeInteger(i.price)&&i.price>0).forEach(([key,item])=>{ %><article class="furnishing-sale" data-name="<%= item.name.toLowerCase() %>"><img src="<%= item.img||'/amenities/default.png' %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/amenities/default.png'"><h3><%= item.name %></h3><p><%= item.desc %></p><strong>$<%= item.price.toLocaleString() %></strong><button class="action-button" data-property-action="buy-furnishing" data-item="<%= key %>" <%= user.cash<item.price?'disabled':'' %>>Buy furnishing</button></article><% }); %></div></section>

</main>
<script src="/js/property.js" defer></script>
