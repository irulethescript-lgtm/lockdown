<div class="contentTabs above">
  <a class="tab active" href="/property"><span><span><span>My Property</span></span></span></a>
  <a class="tab" href="/property-raids"><span><span><span>Property Raids</span></span></span></a>
</div>

<h1>My Property <a class="help" href="#"></a></h1>
<p>Adding items to your property will better your stay here. You can gain more nerve, stamina etc. However, you are limited to a certain amount of space. If you run out of space, delete some things or <a href="/broker-supplies" style="text-decoration:underline;">move to a bigger property!</a></p>

<section class="dashboard-panel" id="homeComfort"><div class="panel-heading"><h2>A home worth coming back to</h2><span class="small-badge">PROPERTY COMFORT</span></div><p class="panel-intro">Each distinct furnishing you place adds 10 to your happiness cap, up to 200. Happiness above 100 improves gym gains, up to 25%. Recover 5 happiness every 15 minutes, even offline, or take a home break.</p><div class="home-comfort-actions"><strong id="homeHappiness"><%= user.happiness %> / <%= user.max_happiness %> happiness</strong><button type="button" class="action-button" id="homeRelax" <%= user.happiness>=user.max_happiness||user.relax_ready_at>Date.now()/1000||user.in_jail||user.in_hospital?'disabled':'' %>>Home break · $50 · +25 happiness</button></div><p class="subtle" id="homeBreakStatus">Available every 30 minutes. Cash is kept if your happiness is already full.</p><div class="game-feedback" role="status" id="homeBreakMessage" hidden></div></section>
<script id="homeLifeState" type="application/json"><%- JSON.stringify({happiness:user.happiness,max_happiness:user.max_happiness,relax_ready_at:user.relax_ready_at,in_jail:user.in_jail,in_hospital:user.in_hospital}) %></script>
<script src="/js/property-life.js" defer></script>

<!-- Cell Combo Section -->
<div style="background:#0d0d0d;border:1px solid #2a2a2a;padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
  <div style="font-size:12px;color:#666;">
    🔒 <b style="color:#aaa;">Property Combo:</b> <span style="font-family:'Oswald',monospace;letter-spacing:3px;color:#555;">●●●●●</span>
    <span style="font-size:10px;color:#444;margin-left:8px;">(hidden for security)</span>
  </div>
  <div style="display:flex;gap:8px;align-items:center;margin-left:auto;">
    <input id="newComboInput" type="text" maxlength="8" placeholder="New combo (4-8 chars)"
      style="background:#111;border:1px solid #333;color:#ddd;padding:5px 10px;font-size:12px;width:160px;font-family:'Oswald',monospace;letter-spacing:2px;">
    <button onclick="changeCombo()" style="background:#1a1a1a;border:1px solid #444;color:#888;font-size:11px;padding:5px 12px;cursor:pointer;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#888'">Change Combo ($500)</button>
  </div>
  <div id="comboMsg" style="display:none;font-size:11px;width:100%;padding-top:4px;"></div>
</div>

<div class="statTable">
  <div class="column">
    <div class="row"><div class="label">Size:</div><div class="data" id="cellSize"><%= user.cell_size || '8x12' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">HP:</div><div class="data" id="hpAugment" style="color:<%= augments.max_hp > 0 ? '#00cc00' : augments.max_hp < 0 ? '#cc0000' : '' %>"><%= augments.max_hp !== 0 ? (augments.max_hp > 0 ? '+' : '')+augments.max_hp : '--' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">Strength:</div><div class="data" id="strengthAugment" style="color:<%= augments.strength > 0 ? '#00cc00' : augments.strength < 0 ? '#cc0000' : '' %>"><%= augments.strength !== 0 ? (augments.strength > 0 ? '+' : '')+augments.strength : '--' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">Defense:</div><div class="data" id="defenseAugment" style="color:<%= augments.defense > 0 ? '#00cc00' : augments.defense < 0 ? '#cc0000' : '' %>"><%= augments.defense !== 0 ? (augments.defense > 0 ? '+' : '')+augments.defense : '--' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">Pack Slots:</div><div class="data" id="packAugment">--</div><div class="breaker"></div></div>
  </div>
  <div class="column right">
    <div class="row"><div class="label">Speed:</div><div class="data" id="speedAugment" style="color:<%= augments.speed > 0 ? '#00cc00' : augments.speed < 0 ? '#cc0000' : '' %>"><%= augments.speed !== 0 ? (augments.speed > 0 ? '+' : '')+augments.speed : '--' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">Energy:</div><div class="data" id="energyAugment" style="color:<%= augments.max_energy > 0 ? '#00cc00' : augments.max_energy < 0 ? '#cc0000' : '' %>"><%= augments.max_energy !== 0 ? (augments.max_energy > 0 ? '+' : '')+augments.max_energy : '--' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">Nerve:</div><div class="data" id="nerveAugment" style="color:<%= augments.max_nerve > 0 ? '#00cc00' : augments.max_nerve < 0 ? '#cc0000' : '' %>"><%= augments.max_nerve !== 0 ? (augments.max_nerve > 0 ? '+' : '')+augments.max_nerve : '--' %></div><div class="breaker"></div></div>
    <div class="row"><div class="label">Stamina:</div><div class="data" id="staminaAugment" style="color:<%= augments.stamina > 0 ? '#00cc00' : augments.stamina < 0 ? '#cc0000' : '' %>"><%= augments.stamina !== 0 ? (augments.stamina > 0 ? '+' : '')+augments.stamina : '--' %></div><div class="breaker"></div></div>
  </div>
  <div class="breaker"></div>
</div>

<h1 style="position:relative; z-index:9000;">
  <div style="float:left;">Manage Property</div>
  <div class="rightaligned">
    <span class="h1TxtButton" onclick="clearCell();" title="empty property">clear</span>
  </div>
  <div>&nbsp;</div>
</h1>

<!-- Item info bubble -->
<div id="itemBubble" style="display:none; position:fixed; z-index:9999; background:#222; border:1px solid #cc0000; padding:10px; max-width:200px; font-size:11px; color:#ccc; pointer-events:none;">
  <div id="bubbleIcon" style="font-size:2rem;text-align:center;"></div>
  <div id="bubbleName" style="color:#fff;font-weight:bold;text-align:center;margin:4px 0;"></div>
  <div id="bubbleDesc" style="color:#00cc00;text-align:center;"></div>
  <div id="bubblePrice" style="color:#ccaa00;text-align:center;font-size:10px;margin-top:4px;"></div>
</div>

<!-- Cell Grid -->
<div id="cellArea" style="
  display: grid;
  grid-template-columns: repeat(<%= cols %>, 1fr);
  gap: 1px;
  background: #1a1a18;
  border: 1px solid #555553;
  padding: 4px;
  margin-bottom: 8px;
  position: relative;
">
  <% for(let i = 1; i <= totalTiles; i++) {
    const placed = placedMap[i];
  %>
  <div class="cellTile <%= placed ? 'occupied' : '' %>"
       id="cellTile<%= i %>"
       data-tile="<%= i %>"
       data-db-id="<%= placed ? placed.db_id : '' %>"
       data-key="<%= placed ? placed.key : '' %>"
       draggable="<%= placed ? 'true' : 'false' %>"
       onclick="tileClick(this)"
       onmouseenter="<%= placed ? `showBubble(event,'${placed.img || '/amenities/default.png'}','${placed.name}','${placed.desc.replace(/'/g,"\\'")}')` : '' %>"
       onmouseleave="hideBubble()"
       ondragstart="dragStart(event)"
       ondragover="dragOver(event)"
       ondrop="dropOn(event)">
    <% if (placed) { %>
      <span class="tileIcon"><img src="<%= placed.img || '/amenities/default.png' %>" class="amenityTileImg" onerror="this.src='/amenities/default.png'"></span>
      <% if (placed.protected) { %><span class="tileLock" title="Protected — cannot be raided">🔒</span><% } %>
      <span class="tileX" onclick="removeItem(event, <%= placed.db_id %>)">✕</span>
    <% } %>
  </div>
  <% } %>
</div>

<p style="position:relative; z-index:1; font-size:11px;">
  Amenities with <span style="color:#f7c339;">gold</span> outlines are protected and can NOT be raided.
  Click an item to see a description. Click again and drag to re-arrange items in your property.
  Click the <span style="color:#cc3300;">red X</span> to remove amenities from your property.
</p>

<!-- Cell Amenities Section -->
<h1>Home Furnishings</h1>
<p style="font-size:11px;">Here are all the items you've purchased for your property but are not currently in your property. You may sell unused items in the marketplace.</p>
<p style="font-size:11px;">Amenities purchased direct from the broker and special events are <span style="color:#f7c339;">protected</span> and can't be raided</p>

<div class="cellToggleBar">
  <span id="normalToggleBtn" class="active" onclick="setList('normal')">Normal Amenities</span>
  <span id="protectedToggleBtn" onclick="setList('protected')">Protected Amenities</span>
</div>

<div id="normalAmenityListing">
  <% if (!unplacedRows.length) { %>
    <div style="text-align:center; padding:10px; color:#888; font-size:11px;">
      No Amenities! Visit <a href="/broker-supplies" style="text-decoration:underline;">The Broker</a> or the Marketplace to get some
    </div>
  <% } else { %>
    <div style="display:flex; flex-wrap:wrap; gap:6px; padding:8px;">
      <% unplacedRows.forEach(row => {
        const a = CELL_AMENITIES[row.item_key];
        if (!a) return;
      %>
      <div class="amenityChip"
           data-db-id="<%= row.id %>"
           data-key="<%= row.item_key %>"
           draggable="true"
           onclick="selectAmenity(this)"
           onmouseenter="showBubble(event,'<%= a.img || '/amenities/default.png' %>','<%= a.name %>','<%= a.desc.replace(/'/g,"\\'") %>')"
           onmouseleave="hideBubble()"
           ondragstart="chipDragStart(event)">
        <span style="display:inline-block;width:36px;height:42px;vertical-align:middle;"><img src="<%= a.img || '/amenities/default.png' %>" style="width:100%;height:100%;object-fit:contain;" onerror="this.src='/amenities/default.png'"></span>
        <span class="chipName"><%= a.name %></span>
        <span class="chipBoost"><%= a.desc %></span>
      </div>
      <% }); %>
    </div>
  <% } %>
</div>

<div id="protectedAmenityListing" style="display:none; text-align:center; padding:10px; color:#888; font-size:11px;">
  You have no protected amenities. Amenities bought from the Broker or the Bootleg Bin are automatically protected from raids.
</div>

<div class="borderedText" style="margin-top:10px; font-size:11px;">
  To get more amenities for your property, visit <a href="/broker-supplies" style="text-decoration:underline;">The Broker</a>.
  To upgrade the size of your property, <a href="/broker-supplies" style="text-decoration:underline;">click here</a>.
</div>

<div id="cellStatusMsg" style="display:none; margin-top:8px;" class="result-box show"></div>

<style>
.cellTile {
  width: 100%;
  aspect-ratio: 1;
  min-height: 30px;
  background: rgba(255,255,255,0.025);
  border: 1px solid #2e2e2c;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.1s, border-color 0.1s;
  overflow: hidden;
}
.cellTile:hover { background: rgba(204,0,0,0.12); border-color: #555; }
.cellTile.occupied { background: rgba(30,60,30,0.35); border-color: #3a4a3a; }
.cellTile.occupied:hover { border-color: #cc3300; }
.cellTile.selected-tile { background: rgba(204,0,0,0.25) !important; border: 2px solid #ff4444 !important; }
.cellTile.drag-over { background: rgba(204,100,0,0.3) !important; border-color: #ff8800 !important; }
.tileIcon { font-size: clamp(0.6rem, 1.5vw, 1.2rem); pointer-events: none; }
.tileX {
  position: absolute;
  top: 0; right: 0;
  background: #cc3300;
  color: #fff;
  width: 13px; height: 13px;
  font-size: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.1s;
  z-index: 5;
}
.cellTile.occupied:hover .tileX { opacity: 1; }
.tileLock {
  position: absolute;
  top: 1px; left: 2px;
  font-size: 9px;
  z-index: 5;
  pointer-events: none;
  opacity: 0.9;
}
.cellTile.occupied { border-color: #444; }
.cellTile.occupied:has(.tileLock) { border-color: #c8a000 !important; box-shadow: 0 0 4px rgba(200,160,0,0.4); }

.cellToggleBar {
  display: flex;
  margin-bottom: 0;
}
.cellToggleBar span {
  padding: 5px 14px;
  background: #1a1a18;
  border: 1px solid #555553;
  color: #aaa;
  font-size: 11px;
  cursor: pointer;
  font-family: Arial, sans-serif;
}
.cellToggleBar span.active {
  background: #cc0000;
  color: #fff;
  border-color: #cc0000;
}

.amenityChip {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0,0,0,0.4);
  border: 1px solid #444442;
  padding: 8px 10px;
  cursor: pointer;
  width: 100px;
  text-align: center;
  transition: all 0.15s;
}
.amenityChip:hover { border-color: #cc0000; background: rgba(180,0,0,0.1); }
.amenityChip.selected { border-color: #f7c339; background: rgba(200,150,0,0.1); }
.chipName { font-size: 10px; color: #ccc; margin-top: 3px; font-family: Arial, sans-serif; }
.chipBoost { font-size: 9px; color: #00cc00; margin-top: 2px; }

.h1TxtButton {
  background: none;
  border: 1px solid #777775;
  color: #ccc;
  padding: 2px 7px;
  font-size: 11px;
  cursor: pointer;
  margin-left: 4px;
  font-family: Arial, sans-serif;
}
.h1TxtButton:hover { background: #333; color: #fff; }
</style>

<script>
// Embedded amenity data for client-side use
const AMENITIES = <%- JSON.stringify(
  Object.entries(CELL_AMENITIES).reduce((acc, [k, v]) => {
    acc[k] = { name: v.name, img: v.img || '/amenities/default.png', desc: v.desc };
    return acc;
  }, {})
) %>;

let selectedAmenityEl = null;
let selectedTileNum = null;
let dragSrcDbId = null;
let dragSrcTile = null;
let dragSrcEl = null;

// ── Bubble ──
function showBubble(e, imgSrc, name, desc) {
  const b = document.getElementById('itemBubble');
  const iconEl = document.getElementById('bubbleIcon');
  iconEl.innerHTML = `<img src="${imgSrc}" style="width:40px;height:48px;object-fit:contain;" onerror="this.style.display='none'">`;
  document.getElementById('bubbleName').textContent = name;
  document.getElementById('bubbleDesc').textContent = desc;
  document.getElementById('bubblePrice').textContent = '';
  b.style.display = 'block';
  moveBubble(e);
}
function hideBubble() { document.getElementById('itemBubble').style.display = 'none'; }
document.addEventListener('mousemove', function(e) {
  const b = document.getElementById('itemBubble');
  if (b.style.display !== 'none') moveBubble(e);
});
function moveBubble(e) {
  const b = document.getElementById('itemBubble');
  b.style.left = (e.clientX + 14) + 'px';
  b.style.top  = (e.clientY + 14) + 'px';
}

// ── Toggle normal/protected ──
function setList(which) {
  document.getElementById('normalAmenityListing').style.display   = which === 'normal'    ? '' : 'none';
  document.getElementById('protectedAmenityListing').style.display = which === 'protected' ? '' : 'none';
  document.getElementById('normalToggleBtn').className    = which === 'normal'    ? 'active' : '';
  document.getElementById('protectedToggleBtn').className = which === 'protected' ? 'active' : '';
}

// ── Select amenity chip ──
function selectAmenity(el) {
  document.querySelectorAll('.amenityChip.selected').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  selectedAmenityEl = el;
  showStatus('Now click an empty tile in your property to place ' + el.querySelector('.chipName').textContent + '.', false);
  if (selectedTileNum) placeItem(selectedTileNum, el.dataset.dbId);
}

// ── Tile click ──
function tileClick(el) {
  const tileNum = parseInt(el.dataset.tile);
  if (el.classList.contains('occupied')) return; // only remove via X button
  document.querySelectorAll('.cellTile.selected-tile').forEach(t => t.classList.remove('selected-tile'));
  if (selectedTileNum === tileNum) { selectedTileNum = null; return; }
  selectedTileNum = tileNum;
  el.classList.add('selected-tile');
  if (selectedAmenityEl) {
    placeItem(tileNum, selectedAmenityEl.dataset.dbId);
  } else {
    showStatus('Tile ' + tileNum + ' selected. Now click an amenity below to place it.', false);
  }
}

// ── Place ──
function placeItem(tile, dbId) {
  fetch('/property/place', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ db_id: dbId, tile: tile })
  })
  .then(r => r.json())
  .then(d => {
    if (d.error) { showStatus(d.error, true); return; }
    location.reload();
  });
}

// ── Remove ──
function removeItem(e, dbId) {
  e.stopPropagation();
  if (!confirm('Remove this amenity from your property?')) return;
  fetch('/property/remove', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ db_id: dbId })
  })
  .then(r => r.json())
  .then(d => { if (d.ok) location.reload(); else showStatus(d.error, true); });
}

// ── Clear all ──
function clearCell() {
  if (!confirm('Remove ALL amenities from your property?')) return;
  fetch('/property/clear', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
  .then(r => r.json()).then(d => { if (d.ok) location.reload(); else showStatus(d.error, true); });
}

// ── Drag from grid tile ──
function dragStart(e) {
  const el = e.currentTarget;
  dragSrcDbId = el.dataset.dbId;
  dragSrcTile = parseInt(el.dataset.tile);
  dragSrcEl = el;
  e.dataTransfer.effectAllowed = 'move';
}
function dragOver(e) {
  e.preventDefault();
  e.currentTarget.classList.add('drag-over');
}
function dropOn(e) {
  e.preventDefault();
  const target = e.currentTarget;
  target.classList.remove('drag-over');
  const destTile = parseInt(target.dataset.tile);
  if (destTile === dragSrcTile) return;
  if (target.classList.contains('occupied')) {
    showStatus('That tile is already occupied.', true); return;
  }
  if (!dragSrcDbId) return;
  placeItem(destTile, dragSrcDbId);
}
document.querySelectorAll('.cellTile').forEach(t => {
  t.addEventListener('dragleave', () => t.classList.remove('drag-over'));
});

// ── Drag from amenity chip ──
function chipDragStart(e) {
  const el = e.currentTarget;
  dragSrcDbId = el.dataset.dbId;
  dragSrcTile = null;
  dragSrcEl = el;
  e.dataTransfer.effectAllowed = 'move';
}

// ── Status ──
function showStatus(msg, isError) {
  const el = document.getElementById('cellStatusMsg');
  el.style.display = 'block';
  el.style.borderColor = isError ? '#cc0000' : '#ccaa00';
  el.style.color = isError ? '#ff6666' : '#ccaa00';
  el.textContent = msg;
}

// ── Change cell combo ──
function changeCombo() {
  const val = document.getElementById('newComboInput').value.trim();
  if (!val) return;
  fetch('/property/change-combo', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ new_combo: val })
  }).then(r=>r.json()).then(d => {
    const el = document.getElementById('comboMsg');
    el.style.display = 'block';
    el.style.color = d.error ? '#ff8888' : '#88ff88';
    el.textContent = d.msg || d.error;
    if (d.user) updateStats(d.user);
    if (!d.error) document.getElementById('newComboInput').value = '';
  });
}
</script>
