<div class="item-browser" data-mode="<%= mode %>">
  <aside class="item-categories" aria-label="Item categories">
    <h2>Categories</h2>
    <% categories.forEach(cat => { %>
    <button type="button" data-category="<%= cat.key %>" aria-pressed="<%= cat.key === 'all' %>"><span><%= cat.name %></span><b><%= cat.count %></b></button>
    <% }); %>
  </aside>
  <section class="item-results" aria-label="<%= mode === 'market' ? 'Market catalog' : 'Owned items' %>">
    <div class="item-tools">
      <label>Search items<input type="search" id="item-search" placeholder="Search by name or effect…" autocomplete="off"></label>
      <label>Sort by<select id="item-sort"><option value="name">Name: A–Z</option><option value="price-up">Value: low to high</option><option value="price-down">Value: high to low</option><% if (mode === 'inventory') { %><option value="quantity">Quantity</option><% } %></select></label>
    </div>
    <p class="item-result-count" id="item-result-count" aria-live="polite"></p>
    <div class="item-list" id="item-list">
      <% rows.forEach(row => { %>
      <article class="item-row" data-name="<%= row.name %>" data-description="<%= row.desc %>" data-category="<%= row.category %>" data-price="<%= row.price %>" data-quantity="<%= row.quantity %>" data-key="<%= row.item_key %>" data-type="<%= row.item_type %>">
        <img class="item-art" src="<%= row.img %>" alt="" loading="lazy" onerror="this.onerror=null;this.src='/amenities/default.png'">
        <div class="item-copy">
          <h3><%= row.name %> <% if (mode === 'inventory') { %><span class="item-quantity">×<%= row.quantity %></span><% } %></h3>
          <p><%= row.desc %></p>
          <% if (row.sourceId) { %><details><summary>Lock down item details</summary><p><%= row.sourceDescription || 'No description available.' %></p><small>Reference description; the playable Lock down effect is shown above.</small></details><% } %>
          <small><%= categories.find(cat => cat.key === row.category)?.name || 'Other' %><% if (row.equipped) { %> · <strong>Equipped</strong><% } %><% if (row.sourceId) { %> · #<%= row.sourceId %><% if (row.sourceImageUnavailable) { %> · Source image unavailable<% } %><% } %><% if (!row.tradeable) { %> · Non-tradeable<% } %></small>
          <% if (row.group && mode === 'inventory') { %><small class="item-recovery" data-ready="<%= row.readyAt %>"><%= row.group.label %> · <%= row.group.duration / 60 %>m recovery</small><% } %>
        </div>
        <div class="item-value"><span><%= mode === 'market' ? 'PRICE' : 'UNIT VALUE' %></span><b><%= row.price ? '$' + row.price.toLocaleString() : '—' %></b></div>
        <div class="item-actions">
          <% if (mode === 'market') { %>
            <small class="market-stock">Stock: <b><%= row.stock %></b></small><% if (row.available) { %><label class="item-buy-quantity">Qty<input type="number" min="1" max="<%= Math.min(100,row.stock) %>" step="1" value="1" aria-label="Quantity of <%= row.name %>"></label><button class="action-button" data-action="buy">Buy</button><% } else { %><span class="item-locked"><% if (!row.forSale) { %>Unavailable entry<% } else { %>Sold out<% } %></span><% } %>
          <% } else { %>
            <% if (row.usable) { %><button class="action-button" data-action="use" data-ready="<%= row.availableAt %>">Use</button><% } %>
            <% if (row.equippable) { %><button class="action-button" data-action="<%= row.equipped ? 'unequip' : 'equip' %>"><%= row.equipped ? 'Unequip' : 'Equip' %></button><% } %>
            <% if (row.known && row.tradeable) { %><button class="item-secondary" data-action="list">Sell</button><% } %>
            <% if (row.item_type === 'amenity') { %><a class="text-link" href="/property">Place →</a><% } %>
          <% } %>
        </div>
      </article>
      <% }); %>
    </div>
    <div class="item-empty" id="item-empty" hidden><h3>No items found</h3><p><%= mode === 'inventory' ? 'Try another category or visit the market to build your collection.' : 'Try a different search or category.' %></p><% if (mode === 'inventory') { %><a href="/market" class="text-link">Browse the market →</a><% } %></div>
  </section>
</div>
<% if (mode === 'inventory') { %>
<dialog id="item-sell-dialog" class="item-sell-dialog">
  <form id="item-sell-form">
    <h2>Sell <span id="item-sell-name"></span></h2>
    <p>List on the Open Market. The buyer pays the total price; you receive 90% after the sale fee.</p>
    <label>Quantity<input id="item-sell-quantity" type="number" min="1" max="1000000" step="1" value="1" required></label>
    <label>Total asking price ($)<input id="item-sell-price" type="number" min="1" max="1000000000" step="1" required></label>
    <p id="item-sell-feedback" role="status"></p>
    <div class="item-dialog-actions"><button type="button" id="item-sell-cancel" class="item-secondary">Cancel</button><button type="submit" class="action-button">Create listing</button></div>
  </form>
</dialog>
<% } %>
