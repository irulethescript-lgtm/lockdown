<div class="world-table-scroll"><table class="world-table"><thead><tr><th>Item</th><th>Category</th><th>Stock</th><th>Buy overseas</th><th>Home value</th><th>Profit / item</th><th>Profit / min</th><th><%= compact?'Availability':'Buy cargo' %></th></tr></thead><tbody>
<% offers.forEach(g=>{ const home=getItem(g.type,g.key).price; const profit=Math.floor(home*.9)-g.price; const max=Math.max(0,Math.min(g.quantity,travel.trip.capacity-used,Math.floor(user.cash/g.price))); %>
<tr data-overseas-name="<%= g.name %>" data-group="<%= g.group %>" class="<%= g.quantity<1?'sold-out':'' %>"><td><img src="<%= g.img %>" alt="" loading="lazy"><strong><%= g.name %></strong></td><td><%= groups[g.group] %></td><td><%= g.quantity.toLocaleString() %><% if(g.rare) { %><small><%= g.available?'Limited · ends '+new Date(g.expires_at*1000).toISOString().slice(11,16)+' UTC':'Rare · unavailable' %></small><% } %></td><td>$<%= g.price.toLocaleString() %></td><td>$<%= home.toLocaleString() %></td><td class="<%= profit>=0?'profit':'loss' %>"><%= profit<0?'−':'' %>$<%= Math.abs(profit).toLocaleString() %></td><td class="<%= profit>=0?'profit':'loss' %>">$<%= (profit/(destination.minutes*2)).toFixed(2) %></td><td><% if(compact) { %><%= g.rare?'Limited offer':'In stock' %><% } else { %><input aria-label="Quantity of <%= g.name %>" id="buy-<%= g.key %>" data-price="<%= g.price %>" type="number" min="1" max="<%= max %>" step="1" value="1"><button class="action-button" data-travel-action="buy" data-item="<%= g.key %>" data-type="<%= g.type %>" <%= max<1?'disabled':'' %>><%= g.quantity<1?'Sold out':'Buy' %></button><% } %></td></tr>
<% }); %><% if(!offers.length) { %><tr><td colspan="8">No stock available. Check the next hourly restock.</td></tr><% } %></tbody></table></div>
