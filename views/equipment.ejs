<div class="returnlink"><a href="/city">back to city hall</a></div>

<style>
.contentTabs { display:flex; margin-bottom:0; }
.contentTabs .tab {
  display:inline-block; padding:5px 14px;
  background:#222; border:1px solid #555; border-bottom:none;
  color:#aaa; font-size:11px; margin-right:2px; text-decoration:none;
}
.contentTabs .tab.active { background:#cc0000; color:#fff; border-color:#cc0000; }

.equipSlot {
  background:#111; border:1px solid #333; padding:8px; text-align:center;
}
.slotLabel { font-size:10px; color:#888; margin-bottom:4px; font-family:Arial; }
.slotItem { display:flex; flex-direction:column; align-items:center; gap:2px; }

.invGrid { display:grid; grid-template-columns:repeat(4,1fr); gap:4px; }
.invCard {
  background:#0d0d0d; border:1px solid #2a2a2a; padding:4px;
  text-align:center; position:relative;
}
.invCard.equipped { border-color:#ccaa00; background:rgba(180,140,0,0.1); }
.invQty {
  position:absolute; top:2px; left:2px;
  background:#333; color:#fff; font-size:9px;
  padding:1px 4px; min-width:14px; text-align:center;
}
.invIcon { font-size:1.8rem; margin:4px 0 2px; }
.invName { font-size:9px; color:#ccc; margin-bottom:2px; font-family:Arial; line-height:1.2; }
.invDesc { font-size:8px; color:#00aa00; margin-bottom:4px; }
.invBtns { display:flex; gap:2px; justify-content:center; }
.invBtn {
  width:22px; height:18px; font-size:9px; font-weight:bold;
  border:none; cursor:pointer; font-family:Arial;
}
.equip-btn   { background:#2a5a2a; color:#0f0; }
.equipped-btn{ background:#ccaa00; color:#000; }
.sell-btn    { background:#1a3a5a; color:#0af; }
.drop-btn    { background:#5a1a1a; color:#f44; }
.invBtn:hover { opacity:0.8; }
</style>

<script>
function equipItem(slot, key) {
  doEquip({ action:'equip', slot, key });
}
function unequip(slot) {
  doEquip({ action:'unequip', slot });
}
function doEquip(body) {
  fetch('/equipment/equip', {
    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)
  }).then(r=>r.json()).then(d=>{
    if (d.error) showMsg(d.error, true);
    else { showMsg(d.msg, false); setTimeout(()=>location.reload(), 600); }
  });
}
function sellItem(key, type, btn) {
  const price = prompt('List price? (50% goes to you immediately)');
  if (!price) return;
  fetch('/inventory/sell', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({ item_key:key, item_type:type, price:parseInt(price)||0 })
  }).then(r=>r.json()).then(d=>{
    if (d.error) showMsg(d.error, true);
    else { showMsg(d.msg, false); setTimeout(()=>location.reload(), 800); }
  });
}
function dropItem(key, type, btn) {
  if (!confirm('Drop this item? It will be lost forever.')) return;
  fetch('/inventory/drop', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({ item_key:key, item_type:type })
  }).then(r=>r.json()).then(d=>{
    if (d.ok) location.reload(); else showMsg(d.error, true);
  });
}
function showMsg(msg, isError) {
  const el = document.getElementById('equipMsg');
  el.style.display='block';
  el.style.color = isError ? '#ff6666' : '#00cc00';
  el.style.borderColor = isError ? '#cc0000' : '#00cc00';
  el.textContent = msg;
}
</script>
