<div class="contentTabs above">
  <a class="tab active" href="/equipment">Armor &amp; Weapons</a>
  <a class="tab" href="/inventory">Items &amp; Drugs</a>
</div>

<div id="equipMsg" style="display:none;margin-bottom:8px;" class="result-box show"></div>

<div class="contentBlock">
  <div class="blockTitle">My Equipment</div>
  <div class="blockBody">
    <p style="font-size:11px;color:#888;">Adding armor and weapons will increase your attack and defense. You can only equip one armor, one weapon and one gear at a time.</p>
    <div style="display:flex;gap:16px;align-items:flex-start;margin-top:10px;">
      <!-- Avatar placeholder -->
      <div style="width:80px;height:100px;background:#111;border:1px solid #333;display:flex;align-items:center;justify-content:center;font-size:2.5rem;">🧑</div>
      <!-- Slots -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:1;">
        <div class="equipSlot" id="slot_weapon">
          <div class="slotLabel">Weapon 🔴</div>
          <% if (equipped.weapon) { %>
            <div class="slotItem">
              <img src="<%= WEAPONS[equipped.weapon] ? (WEAPONS[equipped.weapon].img || '/amenities/default.png') : '/amenities/default.png' %>" style="width:36px;height:44px;object-fit:contain;" onerror="this.src='/amenities/default.png'">
              <span style="font-size:10px;color:#ccc;"><%= WEAPONS[equipped.weapon] ? WEAPONS[equipped.weapon].name : equipped.weapon %></span>
            </div>
            <button class="widebutton" style="width:100%;margin-top:4px;font-size:10px;" onclick="unequip('weapon')">Unequip</button>
          <% } else { %>
            <div style="color:#555;font-size:10px;text-align:center;padding:10px;">Empty</div>
          <% } %>
        </div>
        <div class="equipSlot" id="slot_armor">
          <div class="slotLabel">Armor 🔴</div>
          <% if (equipped.armor) { %>
            <div class="slotItem">
              <img src="<%= ARMOR[equipped.armor] ? (ARMOR[equipped.armor].img || '/amenities/default.png') : '/amenities/default.png' %>" style="width:36px;height:44px;object-fit:contain;" onerror="this.src='/amenities/default.png'">
              <span style="font-size:10px;color:#ccc;"><%= ARMOR[equipped.armor] ? ARMOR[equipped.armor].name : equipped.armor %></span>
            </div>
            <button class="widebutton" style="width:100%;margin-top:4px;font-size:10px;" onclick="unequip('armor')">Unequip</button>
          <% } else { %>
            <div style="color:#555;font-size:10px;text-align:center;padding:10px;">Empty</div>
          <% } %>
        </div>
        <div class="equipSlot" id="slot_gear" style="grid-column:1;">
          <div class="slotLabel">Gear 🔴</div>
          <% if (equipped.gear) { %>
            <div class="slotItem">
              <img src="<%= GEAR[equipped.gear] ? (GEAR[equipped.gear].img || '/amenities/default.png') : '/amenities/default.png' %>" style="width:36px;height:44px;object-fit:contain;" onerror="this.src='/amenities/default.png'">
              <span style="font-size:10px;color:#ccc;"><%= GEAR[equipped.gear] ? GEAR[equipped.gear].name : equipped.gear %></span>
            </div>
            <button class="widebutton" style="width:100%;margin-top:4px;font-size:10px;" onclick="unequip('gear')">Unequip</button>
          <% } else { %>
            <div style="color:#555;font-size:10px;text-align:center;padding:10px;">Empty</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- My Weapons -->
<div class="contentBlock">
  <div class="blockTitle">My Weapons</div>
  <div class="blockBody">
    <% if (!invWeapons.length) { %>
      <p style="color:#666;text-align:center;font-size:11px;">No weapons. Visit the <a href="/shop" style="color:#cc0000;">Marketplace</a>.</p>
    <% } else { %>
    <div class="invGrid">
      <% invWeapons.forEach(row => {
        const item = WEAPONS[row.item_key];
        if (!item) return;
        const isEquipped = equipped.weapon === row.item_key;
      %>
      <div class="invCard <%= isEquipped ? 'equipped' : '' %>">
        <div class="invQty"><%= row.quantity %></div>
        <div class="invIcon"><img src="<%= item.img || '/amenities/default.png' %>" style="width:36px;height:44px;object-fit:contain;" onerror="this.src='/amenities/default.png'"></div>
        <div class="invName"><%= item.name %></div>
        <div class="invDesc"><%= item.desc %></div>
        <div class="invBtns">
          <% if (isEquipped) { %>
            <button class="invBtn equipped-btn" onclick="unequip('weapon')">E</button>
          <% } else { %>
            <button class="invBtn equip-btn" onclick="equipItem('weapon','<%= row.item_key %>')">E</button>
          <% } %>
          <button class="invBtn sell-btn" onclick="sellItem('<%= row.item_key %>','weapon',this)">$</button>
          <button class="invBtn drop-btn" onclick="dropItem('<%= row.item_key %>','weapon',this)">✕</button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

