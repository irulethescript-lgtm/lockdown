<div class="page-heading"><div><div class="eyebrow">TRAINING / <%= gym.name %></div><h1>Put in the work.</h1><p>Build your combat stats. Every energy point spent brings a better gym closer.</p></div><a class="text-link" href="/city">Back to overview →</a></div>
<section class="dashboard-panel"><div class="panel-heading"><h2>Train with a clear head</h2><a class="text-link" href="/property">Manage your home →</a></div><p class="panel-intro">Happiness above 100 boosts gains, up to 25%. Each distinct furnishing placed at home adds 10 to your happiness cap (up to 200). Happiness recovers by 5 every 15 minutes, even offline. Training uses 1 happiness per energy.</p><strong id="gymHappiness"><%= user.happiness %> / <%= user.max_happiness %> happiness</strong></section>
<div id="gymMsg" class="game-feedback" role="status" aria-live="polite" hidden></div>
<% if (user.in_jail || user.in_hospital) { %><div class="status-warning">Training is unavailable while you are in <%= user.in_jail ? 'jail' : 'the hospital' %>.</div><% } %>
<section class="dashboard-panel">
  <div class="panel-heading"><h2 id="gymName"><%= gym.name %></h2><span class="rank-chip" id="gymMultiplier"><%= Math.round((gym.multiplier - 1) * 100) %>% training bonus</span></div>
  <p class="panel-intro">Education bonus: +<%= user.perks.training %>% gym gains. <a href="/education">Improve your technique →</a></p>
  <p class="panel-intro">Energy recovers by 1 every 5 minutes. Stamina recovers by 1% every 5 minutes. Each energy point costs 2% stamina and earns 15 XP.</p>
  <div class="training-controls"><div class="training-resources"><div><span>ENERGY</span><strong id="gymEnergy"><%= user.energy %> / <%= user.max_energy %></strong></div><div><span>STAMINA</span><strong id="gymStamina"><%= user.stamina %>%</strong></div></div><div><label for="trainingEnergy">Energy per session</label><div class="energy-choice"><input id="trainingEnergy" type="number" min="1" step="1" max="<%= Math.min(user.energy, Math.floor(user.stamina / 2)) %>" value="1"><button type="button" data-energy="1">1</button><button type="button" data-energy="5">5</button><button type="button" data-energy="max">Max</button></div></div></div>
  <div class="training-cards">
  <% [{key:'strength',name:'Strength',desc:'Hit harder in battle.',img:'/img/train_strength.png'}, {key:'defense',name:'Defense',desc:'Reduce incoming damage.',img:'/img/train_defense.png'}, {key:'speed',name:'Speed',desc:'Land hits, strike first and lower crime risk.',img:'/img/train_speed.png'}, {key:'dexterity',name:'Dexterity',desc:'Evade attacks and survive stronger opponents.',img:'/img/train_speed.png'}].forEach(stat => { %>
    <article class="training-card"><img src="<%= stat.img %>" alt=""><div class="training-card-body"><h2><%= stat.name %></h2><p><%= stat.desc %></p><div class="training-value" id="gymStat-<%= stat.key %>"><%= user[stat.key].toLocaleString() %></div><small>Current stat, including property and equipment</small><div class="training-preview"><span>Expected gain</span><strong class="gainPreview">+2</strong></div><button class="action-button train-button" data-stat="<%= stat.key %>">Train <%= stat.name.toLowerCase() %> ↗</button></div></article>
  <% }); %>
  </div>
  <p class="subtle" id="trainingCost"></p>
</section>
<div class="dashboard-grid">
<section class="dashboard-panel"><div class="panel-heading"><h2>Gym progression</h2><span class="subtle" id="lifetimeEnergy"><%= gym.energySpent %> energy spent</span></div><div class="progress-track large"><span id="gymProgressBar" style="width:<%= gym.progress %>%"></span></div><p class="panel-intro" id="nextGym"><%= gym.nextGym ? `${gym.nextGym.threshold - gym.energySpent} more energy to unlock ${gym.nextGym.name}.` : 'Every gym unlocked. Keep pushing your limits.' %></p><div class="gym-unlocks"><% GYMS.forEach(tier => { %><div data-gym-threshold="<%= tier.threshold %>" class="gym-unlock <%= gym.energySpent >= tier.threshold ? 'unlocked' : '' %>"><span class="unlock-indicator"><%= gym.energySpent >= tier.threshold ? '✓' : '○' %></span><div><strong><%= tier.name %></strong><small><%= tier.threshold %> total energy · +<%= Math.round((tier.multiplier - 1) * 100) %>% gains</small></div></div><% }); %></div></section>
<section class="dashboard-panel"><div class="panel-heading"><h2>Training history</h2><span class="subtle">Last 20 sessions</span></div><canvas id="gymChart" width="600" height="230" aria-label="Base strength, defense, speed and dexterity over recent sessions" role="img" style="width:100%;height:auto;"></canvas><p class="subtle chart-legend"><span>● Strength</span><span>● Defense</span><span>● Speed</span><span>● Dexterity</span></p><p class="subtle" id="historyEmpty" <%= history.length ? 'hidden' : '' %>>Your first training session starts the chart. Values exclude property and equipment bonuses.</p></section>
</div>
<script type="application/json" id="gymState"><%- JSON.stringify({ user: { energy:user.energy, max_energy:user.max_energy, stamina:user.stamina, perks:user.perks, strength:user.strength, defense:user.defense, speed:user.speed, dexterity:user.dexterity, happiness:user.happiness, max_happiness:user.max_happiness, in_jail:user.in_jail, in_hospital:user.in_hospital }, gym, history }) %></script>
<script src="/js/gym.js" defer></script>
