<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lockdown City RPG — Register</title>
<link rel="stylesheet" href="/css/main.css">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&display=swap" rel="stylesheet">
<style>
body { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
</style>
</head>
<body>
<div class="auth-wrap">
  <div class="auth-title">Create Account</div>
  <div class="auth-body">
    <div class="auth-logo">LOCK<span>DOWN</span></div>
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
    <form method="POST" action="/register">
      <div class="form-row">
        <label>Username (3–20 chars, letters/numbers/underscore)</label>
        <input type="text" name="username" maxlength="20" required>
      </div>
      <div class="form-row">
        <label>Password (min 4 chars)</label>
        <input type="password" name="password" required>
      </div>
      <div class="form-row">
        <label>Confirm Password</label>
        <input type="password" name="confirm" required>
      </div>
      <button type="submit" class="btn" style="width:100%; margin-top:8px;">JOIN LOCKDOWN</button>
    </form>
    <p style="color:#888; text-align:center; margin-top:12px; font-size:11px;">
      Already a citizen? <a href="/login" style="color:#cc0000;">Sign in</a>
    </p>
  </div>
</div>
</body>
</html>
