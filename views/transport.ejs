<div class="status-warning">Want a temporary visit to collect items? Open the <a href="/airport">Airport</a>. This page permanently moves your home city.</div>
<%
const prisonDescriptions = Object.fromEntries(PRISONS.map(p=>[p.id,p.desc]));
const transferCosts = { 1:0, 2:2000, 3:5000, 4:12000, 5:35000 };
const levelRanges = { 1:'1+', 2:'10+', 3:'25+', 4:'50+', 5:'100+' };
%>

<div id="transportMsg" style="display:none;padding:8px 12px;margin-bottom:10px;border:1px solid;font-size:12px;"></div>

<!-- Outer frame -->
<div style="border:2px solid #555;background:#2a2a2a;">

  <!-- Title bar -->
  <div style="background:linear-gradient(90deg,#1a1a1a,#2a2a2a);border-bottom:1px solid #555;padding:7px 12px;display:flex;justify-content:space-between;align-items:center;">
    <span style="font-family:'Oswald',sans-serif;font-size:15px;color:#fff;letter-spacing:1px;">City Relocation</span>
    <div style="width:18px;height:18px;background:#336699;border-radius:50%;text-align:center;line-height:18px;font-size:11px;color:#fff;cursor:pointer;" title="Transfer info">?</div>
  </div>

  <!-- Grey body panel -->
  <div style="background:linear-gradient(180deg,#c0bdb5,#b0ada5);padding:14px 16px;">

    <!-- Intro text -->
    <div style="background:rgba(255,255,255,0.35);border:1px solid #aaa;padding:10px 14px;text-align:center;margin-bottom:12px;font-size:12px;color:#1a1a1a;line-height:1.6;">
      Sick of <strong><%= PRISONS.find(p=>p.id===user.prison_id)?.short || 'your city' %></strong>?
      These are permanent relocations. Your job ends and your property is unloaded when you move.
      If you meet the requirements and have the dough, build a new home base.
    </div>

    <!-- Table -->
    <table style="width:100%;border-collapse:collapse;font-size:12px;">
      <thead>
        <tr style="background:linear-gradient(90deg,#8a0000,#5a0000);">
          <th style="padding:7px 10px;text-align:left;color:#ffcc44;font-family:'Oswald',sans-serif;letter-spacing:1px;font-weight:normal;border-right:1px dashed #aa2200;">City Name</th>
          <th style="padding:7px 10px;text-align:center;color:#ffcc44;font-family:'Oswald',sans-serif;letter-spacing:1px;font-weight:normal;border-right:1px dashed #aa2200;">Level</th>
          <th style="padding:7px 10px;text-align:center;color:#ffcc44;font-family:'Oswald',sans-serif;letter-spacing:1px;font-weight:normal;border-right:1px dashed #aa2200;">Property Size</th>
          <th style="padding:7px 10px;text-align:center;color:#ffcc44;font-family:'Oswald',sans-serif;letter-spacing:1px;font-weight:normal;border-right:1px dashed #aa2200;">Cost</th>
          <th style="padding:7px 10px;text-align:center;color:#ffcc44;font-family:'Oswald',sans-serif;letter-spacing:1px;font-weight:normal;"></th>
        </tr>
      </thead>
      <tbody>
      <% PRISONS.forEach((p, i) => {
        const isCurrent = user.prison_id === p.id;
        const canTransfer = user.level >= p.level_req;
        const cost = transferCosts[p.id] || 0;
        const canAfford = user.cash >= cost;
        const isLower = p.id < user.prison_id;
        const rowBg = i % 2 === 0 ? 'rgba(255,255,255,0.45)' : 'rgba(255,255,255,0.25)';
      %>
      <tr style="background:<%= isCurrent ? 'rgba(180,140,0,0.25)' : rowBg %>; border-bottom:1px solid #aaa;">
        <!-- Name -->
        <td style="padding:8px 10px;border-right:1px dashed #aaa;">
          <span style="font-weight:bold;color:<%= isCurrent?'#5a3a00':isLower?'#666':'#1a1a1a' %>;">
            <%= p.name %>
          </span>
          <% if (isCurrent) { %>
            <span style="font-size:10px;color:#884400;margin-left:6px;">◀ HERE</span>
          <% } %>
          <div style="font-size:10px;color:#666;margin-top:2px;font-style:italic;"><%= prisonDescriptions[p.id] || '' %></div>
        </td>
        <!-- Level -->
        <td style="padding:8px 10px;text-align:center;border-right:1px dashed #aaa;color:<%= canTransfer?'#1a1a1a':'#cc0000' %>;font-weight:bold;">
          <%= levelRanges[p.id] || p.level_req+'+' %>
        </td>
        <!-- Cell Size -->
        <td style="padding:8px 10px;text-align:center;border-right:1px dashed #aaa;font-weight:bold;color:#1a1a1a;font-family:'Oswald',sans-serif;font-size:14px;">
          <%= p.max_cell %>
        </td>
        <!-- Cost -->
        <td style="padding:8px 10px;text-align:center;border-right:1px dashed #aaa;font-weight:bold;color:<%= cost===0?'#336600':canAfford?'#5a3a00':'#cc0000' %>;">
          <%= cost === 0 ? 'FREE' : '$'+cost.toLocaleString() %>
        </td>
        <!-- Action -->
        <td style="padding:8px 10px;text-align:center;">
          <% if (isCurrent) { %>
            <span style="font-size:10px;color:#888;font-style:italic;">Current</span>
          <% } else if (!canTransfer) { %>
            <span style="font-size:10px;color:#cc0000;">Lvl <%= p.level_req %> needed</span>
          <% } else if (isLower) { %>
            <span style="font-size:10px;color:#888;">Lower sec.</span>
          <% } else if (!canAfford) { %>
            <span style="font-size:10px;color:#cc0000;">Need $<%= cost.toLocaleString() %></span>
          <% } else { %>
            <button onclick="transfer(<%= p.id %>, '<%= p.name %>', <%= cost %>)"
              style="background:linear-gradient(180deg,#cc2200,#880000);border:1px solid #660000;color:#fff;padding:4px 12px;font-family:'Oswald',sans-serif;font-size:11px;letter-spacing:1px;cursor:pointer;white-space:nowrap;">
              Transfer →
            </button>
          <% } %>
        </td>
      </tr>
      <% }); %>
      </tbody>
    </table>

    <!-- Cash info -->
    <div style="margin-top:10px;text-align:right;font-size:11px;color:#555;">
      Your cash: <strong style="color:#1a1a1a;">$<%= user.cash.toLocaleString() %></strong>
      &nbsp;|&nbsp; Your level: <strong style="color:#1a1a1a;"><%= user.level %></strong>
    </div>

    <!-- Back button -->
    <div style="margin-top:10px;text-align:right;">
      <a href="/airport" style="background:#333;border:1px solid #555;color:#ccc;padding:4px 12px;font-size:10px;text-decoration:none;display:inline-block;">back to city airport</a>
    </div>

  </div>
</div>

<script>
function transfer(prisonId, prisonName, cost) {
  const msg = cost > 0
    ? `Transfer to ${prisonName} for $${cost.toLocaleString()}?`
    : `Transfer to ${prisonName} for FREE?`;
  if (!confirm(msg + '\n\nYour stats and items stay with you.')) return;
  fetch('/relocate/move', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ prison_id: prisonId })
  }).then(r=>r.json()).then(d=>{
    const el = document.getElementById('transportMsg');
    el.style.display='block';
    if (d.error) {
      el.style.color='#ff6666'; el.style.borderColor='#cc0000';
      el.style.background='rgba(80,0,0,0.3)'; el.textContent=d.error;
    } else {
      el.style.color='#00cc00'; el.style.borderColor='#00cc00';
      el.style.background='rgba(0,50,0,0.2)'; el.textContent=d.msg;
      setTimeout(()=>location.reload(), 1200);
    }
  });
}
</script>
