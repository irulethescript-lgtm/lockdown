<%
  const isLeader = myRank === 'Leader';
  const isOfficer = myRank === 'Officer';
%>
<div class="contentBlock">
  <div class="blockTitle">My Faction — <%= gang.name %> [<%= gang.tag %>]</div>
  <div class="blockBody">
    <table class="data-table" style="margin-bottom:14px;">
      <tr><td>Faction Name</td><td style="color:#fff;font-weight:bold;"><%= gang.name %></td></tr>
      <tr><td>Tag</td><td><span class="gang-tag"><%= gang.tag %></span></td></tr>
      <tr><td>Description</td><td style="color:#888;"><%= gang.description || 'None' %></td></tr>
      <tr><td>Bank</td><td style="color:#ccaa00;">$<%= formatCash(gang.bank) %></td></tr>
      <tr><td>Members</td><td><%= members.length %> / <%= maxMembers %></td></tr>
      <tr><td>Your Rank</td><td style="color:#aaa;"><%= myRank %></td></tr>
    </table>

    <div class="blockTitle" style="margin-bottom:8px;">Faction Bank</div>
    <div style="color:#888;margin-bottom:6px;">Your cash: $<%= formatCash(user.cash) %><% if (!isLeader) { %> — only the leader can withdraw.<% } %></div>
    <div class="form-row-inline" style="margin-bottom:14px;">
      <input type="number" id="bankAmount" min="1" step="1" placeholder="Amount" style="flex:1;">
      <button class="btn" onclick="doAction('/gang/deposit',{amount:document.getElementById('bankAmount').value},()=>location.reload())">DEPOSIT</button>
      <% if (isLeader) { %><button class="btn gray" onclick="doAction('/gang/withdraw',{amount:document.getElementById('bankAmount').value},()=>location.reload())">WITHDRAW</button><% } %>
    </div>

    <div class="blockTitle" style="margin-bottom:8px;">Members</div>
    <table class="data-table" style="margin-bottom:14px;">
      <thead><tr><th>Username</th><th>Level</th><th>Rep</th><th>Wins</th><th>Rank</th><% if (isLeader || isOfficer) { %><th></th><% } %></tr></thead>
      <tbody>
        <% members.forEach(m => {
             const isMe = m.user_id === user.id;
             const canKick = !isMe && m.rank !== 'Leader' && (isLeader || (isOfficer && m.rank === 'Member'));
        %>
        <tr>
          <td><a href="/profile/<%= m.username %>"><%= m.username %></a></td>
          <td><%= m.level %></td>
          <td style="color:#ccaa00;"><%= m.rep %></td>
          <td style="color:#00cc00;"><%= m.wins %></td>
          <td style="color:#aaa;"><%= m.rank %></td>
          <% if (isLeader || isOfficer) { %>
          <td style="white-space:nowrap;text-align:right;">
            <% if (isLeader && !isMe) { %>
              <% if (m.rank === 'Member') { %><button class="btn gray" style="padding:2px 8px;font-size:11px;" onclick="doAction('/gang/rank',{user_id:<%= m.user_id %>,rank:'Officer'},()=>location.reload())">PROMOTE</button><% } %>
              <% if (m.rank === 'Officer') { %><button class="btn gray" style="padding:2px 8px;font-size:11px;" onclick="doAction('/gang/rank',{user_id:<%= m.user_id %>,rank:'Member'},()=>location.reload())">DEMOTE</button><% } %>
              <button class="btn gray" style="padding:2px 8px;font-size:11px;" onclick="if(confirm('Make this inmate the gang leader? You will become an Officer.'))doAction('/gang/transfer',{user_id:<%= m.user_id %>},()=>location.reload())">MAKE LEADER</button>
            <% } %>
            <% if (canKick) { %><button class="btn gray" style="padding:2px 8px;font-size:11px;" onclick="if(confirm('Remove this member from the gang?'))doAction('/gang/kick',{user_id:<%= m.user_id %>},()=>location.reload())">KICK</button><% } %>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (isLeader || isOfficer) { %>
    <div class="blockTitle" style="margin-bottom:8px;">Invite a Member</div>
    <div class="form-row-inline" style="margin-bottom:14px;">
      <input type="text" id="inviteUsername" placeholder="Username to invite" style="flex:1;">
      <button class="btn" onclick="doAction('/gang/invite',{username:document.getElementById('inviteUsername').value},()=>location.reload())">INVITE</button>
    </div>
    <% } %>

    <div class="blockTitle" style="margin-bottom:8px;">Faction Log</div>
    <table class="data-table" style="margin-bottom:14px;">
      <tbody>
        <% if (!logs.length) { %><tr><td style="color:#666;">Nothing yet.</td></tr><% } %>
        <% logs.forEach(l => { %>
        <tr>
          <td style="color:#888;white-space:nowrap;"><%= timeAgo(l.created_at) %></td>
          <td><%= l.note %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <div style="margin-top:12px;">
      <% if (!isLeader) { %>
      <button class="btn gray" onclick="if(confirm('Leave the gang?'))doAction('/gang/leave',{},d=>location.href=d.redirect||'/gangs')">LEAVE GANG</button>
      <% } else { %>
      <button class="btn gray" onclick="if(confirm('Disband the gang? Everyone is removed and the bank is paid to you. This cannot be undone.'))doAction('/gang/disband',{},d=>location.href=d.redirect||'/gangs')">DISBAND GANG</button>
      <% } %>
    </div>
  </div>
</div>

